---
import PublicPage from '../layouts/public-page.astro';
import { ProfileSettings } from '../components/profile-settings';
import { getCurrentUser } from '../server/session';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect(`/login?redirect=${encodeURIComponent('/profile')}`);
---
<PublicPage title="Profile" description="Manage your personal details and password.">
  <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
    <section class="rounded-xl border bg-card p-5 shadow-sm sm:p-7">
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Account</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Profile</h1>
      <p class="mt-4 text-base leading-7 text-muted-foreground">Manage your personal details and password.</p>
      <div class="mt-8">
        <ProfileSettings client:load initialProfile={{ name: user.name, email: user.email, image: user.image }} />
      </div>
    </section>
  </article>
</PublicPage>
