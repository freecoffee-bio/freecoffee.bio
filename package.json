{
  "name": "freecoffee",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply freecoffee-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/react": "^6.0.4",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.2",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "worker-mailer": "^1.2.1",
    "wrangler": "^4.127.1",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PATH": {
        "description": "A random, non-obvious path for the admin area, using only lowercase letters (a-z) and numbers (0-9), such as 3q9527ko8."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Login secret. You must replace the default value with random characters using only lowercase letters (a-z) and numbers (0-9), while keeping the same length."
      }
    }
  }
}
