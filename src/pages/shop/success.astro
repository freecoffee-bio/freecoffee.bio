---
import '../../styles/global.css';
const reference = Astro.url.searchParams.get('reference');
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Payment status — FreeCoffee.bio</title></head>
  <body><main class="grid min-h-screen place-items-center bg-muted/30 p-5"><section class="w-full max-w-lg rounded-xl border bg-card p-8 text-center shadow-sm" data-payment-status data-reference={reference ?? ''}><p class="font-mono text-xs uppercase tracking-widest text-primary">Shop order</p><h1 class="mt-3 text-2xl font-semibold" data-status-title>Confirming payment</h1><p class="mt-3 text-sm leading-6 text-muted-foreground" data-status-message>Please wait while we confirm your payment.</p><div class="mt-6 rounded-lg bg-muted p-4 text-left text-sm"><p>Order details and download links will be sent to the receipt email you entered after confirmation.</p></div><div class="mt-6 flex flex-wrap justify-center gap-3"><a class="inline-flex rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground" href="/orders">View my orders</a><a class="inline-flex rounded-lg border px-4 py-2 text-sm hover:bg-muted" href="/">Return home</a></div></section></main><script>
    const container = document.querySelector<HTMLElement>('[data-payment-status]');
    const title = container?.querySelector<HTMLElement>('[data-status-title]');
    const message = container?.querySelector<HTMLElement>('[data-status-message]');
    const referenceId = container?.dataset.reference;

    if (!referenceId) {
      if (title) title.textContent = 'Payment could not be confirmed';
      if (message) message.textContent = 'The order reference is missing. Please open My orders to check its status.';
    } else {
      fetch('/api/paypal/capture', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ referenceId }),
      }).then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Payment could not be confirmed.');
        if (result.status === 'completed') {
          if (title) title.textContent = 'Payment completed';
          if (message) message.textContent = 'Your order is paid. Download access and your receipt will be available shortly.';
        } else {
          if (title) title.textContent = 'Payment submitted';
          if (message) message.textContent = 'Your payment is being confirmed by the payment provider. We will send download links after confirmation.';
        }
      }).catch(() => {
        if (title) title.textContent = 'Payment could not be confirmed';
        if (message) message.textContent = 'We could not confirm the payment yet. Open My orders later to check its status.';
      });
    }
  </script></body>
</html>
