---
import '../../styles/global.css';
import { ToastHost } from '../../components/toast-host';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Turnstile } from '../../components/turnstile';
import { getAdminPath } from '../../lib/config';
import { env } from 'cloudflare:workers';

const adminPath = getAdminPath((env as unknown as { ADMIN_PATH?: string }).ADMIN_PATH);
if (Astro.params.path !== adminPath) return new Response('Not Found', { status: 404 });
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" type="image/png" href="/icon.png" /><title>Admin login — FreeCoffee.bio</title></head><body class="min-h-screen bg-muted/30"><ToastHost client:load /><main class="mx-auto flex min-h-screen max-w-md items-center px-4"><section class="w-full rounded-xl border bg-card p-6 shadow-sm"><p class="font-mono text-xs text-primary">FREECOFFEE / ADMIN</p><h1 class="mt-2 text-3xl font-semibold">Sign in</h1><p class="mt-3 text-sm text-muted-foreground">Sign in with the root account created during installation.</p><form class="mt-7 space-y-4" id="login-form" data-redirect={`/${adminPath}`}><label class="block text-sm font-medium">Email<Input required name="email" type="email" autoComplete="email" className="mt-2 h-11 w-full" /></label><label class="block text-sm font-medium">Password<Input required name="password" type="password" autoComplete="current-password" className="mt-2 h-11 w-full" /></label><Turnstile client:load /><Button className="h-11 w-full" type="submit">Sign in</Button></form><script>const form = document.querySelector<HTMLFormElement>('#login-form'); const showToast = (message: string) => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type: 'error' } })); form?.addEventListener('submit', async (event) => { event.preventDefault(); const body = Object.fromEntries(new FormData(form)); const response = await fetch('/api/auth/sign-in/email', { method: 'POST', headers: { 'content-type': 'application/json', 'x-captcha-response': form.querySelector('[data-turnstile-token]')?.value || '' }, body: JSON.stringify(body) }); const result = await response.json().catch(() => ({})); const redirect = form.dataset.redirect || '/admin'; if (response.ok && result.twoFactorRedirect) window.location.href = `/two-factor?redirect=${encodeURIComponent(redirect)}`; else if (response.ok) window.location.href = redirect; else showToast(result.message || 'Unable to sign in. Check your credentials and try again.'); });</script></section></main></body></html>
