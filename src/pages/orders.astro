---
import PublicPage from '../layouts/public-page.astro';
import { getCurrentUser } from '../server/session';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect(`/login?redirect=${encodeURIComponent('/orders')}`);
---
<PublicPage title="My orders" description="View your purchases and download digital products.">
  <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
    <section class="rounded-xl border bg-card p-5 shadow-sm sm:p-7">
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Account</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">My orders</h1>
      <p class="mt-4 text-base leading-7 text-muted-foreground">View your purchases and download digital products.</p>
    </section>
    <div id="orders" class="mt-5 grid gap-4">
      <p class="rounded-xl border bg-card p-6 text-muted-foreground">Loading orders…</p>
    </div>
  </article>
  <script>
    const root = document.querySelector('#orders');
    const money = (amount, currency) => `${(amount / (currency === 'JPY' ? 1 : 100)).toFixed(currency === 'JPY' ? 0 : 2)} ${currency}`;
    fetch('/api/orders').then(async response => { const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Unable to load orders.'); return data.orders; }).then(orders => { if (!orders.length) { root.innerHTML = '<p class="rounded-xl border bg-card p-6 text-muted-foreground">You have no orders yet.</p>'; return; } root.replaceChildren(...orders.map(entry => { const card = document.createElement('section'); card.className = 'rounded-xl border bg-card p-6 shadow-sm'; if (entry.kind === 'support') { const support = entry.support; card.innerHTML = `<div class="flex flex-wrap justify-between gap-2"><div><h2 class="font-semibold">Support payment</h2><p class="mt-1 text-sm text-muted-foreground">${new Date(support.createdAt).toLocaleString()}</p></div><strong>${money(support.amount, support.currency)}</strong></div><p class="mt-3 text-sm capitalize text-muted-foreground">Status: ${support.status}</p>`; return card; } const { order, items, downloads } = entry; const names = items.map(item => `${item.name} × ${item.quantity}`).join(', '); card.innerHTML = `<div class="flex flex-wrap justify-between gap-2"><div><h2 class="font-semibold">${names || 'Order'}</h2><p class="mt-1 text-sm text-muted-foreground">Order ${order.id} · ${new Date(order.createdAt).toLocaleString()}</p></div><strong>${money(order.totalAmount, order.currency)}</strong></div><p class="mt-3 text-sm capitalize text-muted-foreground">Status: ${order.status}</p>`; if (downloads.length) { const list = document.createElement('div'); list.className = 'mt-4 grid gap-2 border-t pt-4'; downloads.forEach(download => { const link = document.createElement('a'); link.href = download.url; link.className = 'inline-flex w-fit rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground hover:opacity-90'; link.textContent = 'Download'; list.append(link); }); card.append(list); } else if (order.status === 'paid') { const note = document.createElement('p'); note.className = 'mt-4 text-sm text-muted-foreground'; note.textContent = 'The download is not available yet. Please contact the creator.'; card.append(note); } return card; })); }).catch(error => { root.innerHTML = `<p class="rounded-xl border border-destructive bg-card p-6 text-destructive">${error.message}</p>`; });
  </script>
</PublicPage>
