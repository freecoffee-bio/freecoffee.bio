---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import { TwoFactorCodeInput } from '../components/two-factor-code-input';

---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <title>Verify sign in — FreeCoffee.bio</title>
  </head>
  <body class="min-h-screen bg-muted/30">
    <ToastHost client:load />
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4">
      <section class="w-full rounded-xl border bg-card p-6 shadow-sm">
        <a href="/" class="inline-flex" aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" class="h-10 w-auto" /></a>
        <h1 class="mt-6 text-3xl font-semibold">Verify your sign in</h1>
        <p class="mt-3 text-sm text-muted-foreground">Enter the six-digit code from your authenticator app.</p>
        <form class="mt-7 space-y-4" id="two-factor-form">
          <label class="block text-sm font-medium">Verification code
            <div class="mt-2">
              <TwoFactorCodeInput client:load autoSubmit />
            </div>
          </label>
        </form>
      </section>
    </main>
    <script is:inline>
      const form = document.querySelector('#two-factor-form');
      const showToast = (message) => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type: 'error' } }));
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = Object.fromEntries(new FormData(form));
        if (String(body.code || '').length !== 6) {
          showToast('Enter the six-digit code from your authenticator app.');
          return;
        }
        const response = await fetch('/api/auth/two-factor/verify-totp', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        if (response.ok) window.location.href = new URLSearchParams(window.location.search).get('redirect') || '/';
        else {
          const result = await response.json().catch(() => ({}));
          showToast(result.message || 'Invalid verification code.');
        }
      });
    </script>
  </body>
</html>
