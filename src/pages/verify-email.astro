---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import LogoMark from '../components/logo-mark.astro';
import { Button } from '../components/ui/button';
import { Field, FieldGroup, FieldLabel } from '../components/ui/field';
import { Input } from '../components/ui/input';

const email = Astro.url.searchParams.get('email') ?? '';
const emailSent = Astro.url.searchParams.get('sent') === '1';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Verify your email — FreeCoffee.bio</title></head>
  <body class="min-h-screen bg-muted/30">
    <ToastHost client:load />
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4">
      <section class="w-full rounded-xl border bg-card p-6 shadow-sm">
        <a href="/" class="inline-flex" aria-label="FreeCoffee home"><LogoMark /></a>
        <h1 class="mt-6 text-3xl font-semibold">Verify your email</h1>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">We sent a verification link to <strong id="verification-email"></strong>. Open it to activate your account and sign in.</p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">The link expires in one hour. You can request another one below.</p>
        <form class="mt-7" id="resend-verification-form">
          <FieldGroup>
            <Field>
              <FieldLabel htmlFor="verification-email-input">Email</FieldLabel>
              <Input id="verification-email-input" required name="email" type="email" autoComplete="email" className="h-11" value={email} />
            </Field>
            <Button className="h-11 w-full" type="submit" id="resend-verification-button">Resend verification email</Button>
          </FieldGroup>
        </form>
        <p class="mt-6 text-center text-sm text-muted-foreground"><a class="text-primary underline" href="/login">Back to sign in</a></p>
      </section>
    </main>
    <script is:inline define:vars={{ emailSent }}>
      const form = document.querySelector('#resend-verification-form');
      const emailInput = form?.querySelector('[name="email"]');
      const emailDisplay = document.querySelector('#verification-email');
      const button = document.querySelector('#resend-verification-button');
      const cooldownKey = 'freecoffee:verification-email-cooldown';
      let cooldownTimer;
      let sending = false;

      const showToast = (message, type = 'error') => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type } }));
      const cooldownRemaining = () => {
        try {
          return Math.max(0, Math.ceil((Number(sessionStorage.getItem(cooldownKey)) - Date.now()) / 1000));
        } catch {
          return 0;
        }
      };
      const updateButton = () => {
        if (!(button instanceof HTMLButtonElement)) return;
        const remaining = cooldownRemaining();
        button.textContent = sending ? 'Sending verification email...' : remaining > 0 ? `Resend in ${remaining}s` : 'Resend verification email';
        button.disabled = sending || remaining > 0;
        if (!sending && remaining === 0) {
          try { sessionStorage.removeItem(cooldownKey); } catch {}
          window.clearInterval(cooldownTimer);
        }
      };
      const startCooldown = (seconds) => {
        try { sessionStorage.setItem(cooldownKey, String(Date.now() + seconds * 1000)); } catch {}
        updateButton();
        window.clearInterval(cooldownTimer);
        cooldownTimer = window.setInterval(updateButton, 1000);
      };

      if (emailDisplay) emailDisplay.textContent = emailInput?.value || 'your email address';
      const existingCooldown = cooldownRemaining();
      if (emailSent && existingCooldown === 0) startCooldown(60);
      else if (existingCooldown > 0) startCooldown(existingCooldown);
      else updateButton();

      if (emailSent) {
        let initialToastShown = false;
        const notifyInitialSend = () => {
          if (initialToastShown) return;
          initialToastShown = true;
          showToast('Verification email sent. Check your inbox.', 'success');
        };
        window.addEventListener('freecoffee:toast-ready', notifyInitialSend, { once: true });
        window.setTimeout(notifyInitialSend, 500);
        window.history.replaceState({}, '', `${window.location.pathname}?email=${encodeURIComponent(emailInput?.value || '')}`);
      }

      emailInput?.addEventListener('input', () => {
        if (emailDisplay) emailDisplay.textContent = emailInput.value || 'your email address';
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (sending || cooldownRemaining() > 0 || !(emailInput instanceof HTMLInputElement)) return;
        sending = true;
        updateButton();
        try {
          const response = await fetch('/api/auth/send-verification-email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: emailInput.value, callbackURL: `${window.location.origin}/profile` }) });
          const result = await response.json().catch(() => ({}));
          if (response.ok) {
            if (emailDisplay) emailDisplay.textContent = emailInput.value;
            startCooldown(60);
            showToast('Verification email sent. Check your inbox.', 'success');
          } else {
            const retryAfter = Number(response.headers.get('retry-after'));
            if (response.status === 429 && Number.isFinite(retryAfter) && retryAfter > 0) startCooldown(retryAfter);
            showToast(result.message || 'Unable to send a verification email.');
          }
        } catch {
          showToast('Unable to reach the email service. Please try again.');
        } finally {
          sending = false;
          updateButton();
        }
      });
    </script>
  </body>
</html>
