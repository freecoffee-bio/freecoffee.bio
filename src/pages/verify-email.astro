---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import { Button } from '../components/ui/button';

const email = Astro.url.searchParams.get('email') ?? '';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Verify your email — FreeCoffee.bio</title></head>
  <body class="min-h-screen bg-muted/30">
    <ToastHost client:load />
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4">
      <section class="w-full rounded-xl border bg-card p-6 shadow-sm">
        <a href="/" class="inline-flex" aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" class="h-10 w-auto" /></a>
        <h1 class="mt-6 text-3xl font-semibold">Verify your email</h1>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">We sent a verification link to <strong id="verification-email"></strong>. Open it to activate your account and sign in.</p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">The link expires in one hour. You can request another one below.</p>
        <form class="mt-7 space-y-4" id="resend-verification-form">
          <label class="block text-sm font-medium">Email<input required name="email" type="email" autoComplete="email" class="mt-2 h-11 w-full rounded-md border bg-background px-3" value={email} /></label>
          <Button className="h-11 w-full" type="submit">Resend verification email</Button>
        </form>
        <p class="mt-6 text-center text-sm text-muted-foreground"><a class="text-primary underline" href="/login">Back to sign in</a></p>
      </section>
    </main>
    <script is:inline>
      const form = document.querySelector('#resend-verification-form');
      const email = form?.querySelector('[name="email"]');
      document.querySelector('#verification-email').textContent = email?.value || 'your email address';
      const showToast = (message, type = 'error') => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type } }));
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const response = await fetch('/api/auth/send-verification-email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: email.value, callbackURL: `${window.location.origin}/profile` }) });
        const result = await response.json().catch(() => ({}));
        if (response.ok) showToast('If this account needs verification, a new email has been queued.', 'success');
        else showToast(result.message || 'Unable to send a verification email.');
      });
    </script>
  </body>
</html>
