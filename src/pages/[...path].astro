---
import '../styles/global.css';
import geistLatinFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2';
import { getAdminPath } from '../lib/config';
import { getSiteSettings } from '../server/site-settings';
import { getPaymentSettings } from '../server/payments';
import { getCreatorWorkspace } from '../server/creator';
import { getRootUserId } from '../server/admin';
import { requireRoot } from '../server/session';
import { env } from 'cloudflare:workers';
import { SiPaypal, SiStripe, SiTwitch, SiX, SiYoutube } from '@icons-pack/react-simple-icons';
import { ArrowRight } from 'lucide-react';
import { AdminIcon } from '../components/admin-icon';
import { ToastHost } from '../components/toast-host';

import { MediaManager } from '../components/media-manager';
import { EmailManager } from '../components/email-manager';
import { NotificationsManager } from '../components/notifications-manager';
import { SystemActivityManager } from '../components/system-activity-manager';
import { PaymentsManager } from '../components/payments-manager';
import { getS3Status, listMedia } from '../server/media';
import { getSecurityStatus } from '../server/security';
import { listNotificationDeliveries, listNotificationTemplates } from '../server/notifications';
import { AdminTabs } from '../components/admin-tabs';
import { SocialLinksDialog } from '../components/social-links-dialog';
import { ShareDialog } from '../components/share-dialog';
import { ShopStatusSelect } from '../components/shop-select';
import { ShopProductsManager } from '../components/shop-products-manager';
import { ShopTermsEditor } from '../components/shop-terms-editor';
import { ShopOrdersManager } from '../components/shop-orders-manager';
import { PaymentAccountDialog } from '../components/payment-account-dialog';
import { CommerceSettingsForm } from '../components/commerce-settings-form';
import { PageSettingsForm } from '../components/page-settings-form';
import { SecuritySettings } from '../components/security-settings';
import { ProfileAvatar } from '../components/profile-avatar';
import { Button } from '../components/ui/button';
import { Pagination, PaginationContent, PaginationItem, PaginationLink, PaginationNext, PaginationPrevious } from '../components/ui/pagination';
import { Badge } from '../components/ui/badge';
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '../components/ui/empty';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../components/ui/table';
import { Input } from '../components/ui/input';
import { Textarea } from '../components/ui/textarea';
import { createDb } from '../db';
import { and, desc, eq, gte, like, lte, sql } from 'drizzle-orm';
import { exchangeRates, orders, paymentEvents, products, supportTransactions, users } from '../db/schema';

const siteSettings = await getSiteSettings();
const paymentSettings = await getPaymentSettings();
const securityStatus = await getSecurityStatus(env.DB);
const providerConfigured = {
  stripe: Boolean(paymentSettings.stripeSecretKey && paymentSettings.stripeWebhookSecret),
  paypal: Boolean(paymentSettings.paypalClientId && paymentSettings.paypalClientSecret && paymentSettings.paypalWebhookId),
};

const adminPath = getAdminPath((env as unknown as { ADMIN_PATH?: string }).ADMIN_PATH);
const currentPath = Astro.params.path ?? '';
if (!currentPath.startsWith(adminPath)) return new Response('Not Found', { status: 404 });
if (currentPath === `${adminPath}/gallery` || currentPath === `${adminPath}/posts`) return Astro.redirect(`/${adminPath}`);
if (!(await getRootUserId())) return Astro.redirect('/install');
let sessionUser;
try {
  sessionUser = await requireRoot(Astro.request);
} catch {
  return Astro.redirect(`/${adminPath}/login`);
}

const workspace = await getCreatorWorkspace(sessionUser);
const db = createDb(env.DB);
const orderStatusFilter = Astro.url.searchParams.get('status');
const orderEmailFilter = Astro.url.searchParams.get('email');
const orderFromFilter = Astro.url.searchParams.get('from');
const orderToFilter = Astro.url.searchParams.get('to');
const orderPageSize = 10;
const orderPage = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const orderWhere = and(eq(orders.creatorId, workspace.creator.id), ...(orderStatusFilter ? [eq(orders.status, orderStatusFilter)] : []), ...(orderEmailFilter ? [like(orders.buyerEmail, `%${orderEmailFilter.slice(0, 120)}%`)] : []), ...(orderFromFilter && !Number.isNaN(Date.parse(orderFromFilter)) ? [gte(orders.createdAt, new Date(orderFromFilter))] : []), ...(orderToFilter && !Number.isNaN(Date.parse(orderToFilter)) ? [lte(orders.createdAt, new Date(orderToFilter))] : []));
const orderQuery = new URLSearchParams();
if (orderStatusFilter) orderQuery.set('status', orderStatusFilter);
if (orderEmailFilter) orderQuery.set('email', orderEmailFilter);
if (orderFromFilter) orderQuery.set('from', orderFromFilter);
if (orderToFilter) orderQuery.set('to', orderToFilter);
orderQuery.set('tab', 'orders');
const orderUrl = (page: number) => `?${new URLSearchParams([...orderQuery, ['page', String(page)]]).toString()}`;
const [shopProducts, supports, creatorOrders, orderCount, supportSummary, orderSummary, paymentEventLog, mediaStorage, mediaContent, notificationTemplates, notificationDeliveriesLog] = await Promise.all([
  db.select().from(products).where(eq(products.creatorId, workspace.creator.id)).orderBy(desc(products.createdAt)),
  db.select().from(supportTransactions).where(eq(supportTransactions.creatorId, workspace.creator.id)).orderBy(desc(supportTransactions.createdAt)),
  db.select().from(orders).where(orderWhere).orderBy(desc(orders.createdAt)).limit(orderPageSize).offset((orderPage - 1) * orderPageSize),
  db.select({ count: sql<number>`count(*)` }).from(orders).where(orderWhere),
  db.select({ amount: sql<number>`coalesce(sum(${supportTransactions.amount}), 0)`, count: sql<number>`count(*)` }).from(supportTransactions).where(and(eq(supportTransactions.creatorId, workspace.creator.id), eq(supportTransactions.status, 'paid'))),
  db.select({ amount: sql<number>`coalesce(sum(${orders.totalAmount}), 0)`, count: sql<number>`count(*)` }).from(orders).where(and(eq(orders.creatorId, workspace.creator.id), eq(orders.status, 'paid'))),
  db.select().from(paymentEvents).orderBy(desc(paymentEvents.receivedAt)).limit(50),

  getS3Status(env.DB),
  listMedia(env.DB),
  listNotificationTemplates(),
  listNotificationDeliveries(),
]);
const configuredRates = await db.select({ quoteCurrency: exchangeRates.quoteCurrency, rate: exchangeRates.rate }).from(exchangeRates).where(eq(exchangeRates.baseCurrency, 'USD'));

const totalTransactions = (supportSummary[0]?.count ?? 0) + (orderSummary[0]?.count ?? 0);
const orderTotal = orderCount[0]?.count ?? 0;
const orderPageCount = Math.max(1, Math.ceil(orderTotal / orderPageSize));
const settingsTab = Astro.url.searchParams.get('tab') ?? 'profile';
const publicSiteUrl = siteSettings.siteUrl?.trim() || '';
const isSettings = currentPath === `${adminPath}/settings`;
const isShop = currentPath === `${adminPath}/shop`;
const isPayments = currentPath === `${adminPath}/payments`;
const isEmail = currentPath === `${adminPath}/email`;
const isNotifications = currentPath === `${adminPath}/notifications`;
const isOperations = currentPath === `${adminPath}/operations`;
const isMedia = currentPath === `${adminPath}/media`;
const isSupporters = currentPath === `${adminPath}/supporters`;
const supportersPageSize = 10;
const requestedSupportersPage = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const supporterCount = isSupporters ? (await db.select({ count: sql<number>`count(*)` }).from(users))[0]?.count ?? 0 : 0;
const supporterPageCount = Math.max(1, Math.ceil(supporterCount / supportersPageSize));
const supportersPage = Math.min(requestedSupportersPage, supporterPageCount);
const supporterUsers = isSupporters ? await db.select({ id: users.id, name: users.name, email: users.email, emailVerified: users.emailVerified, createdAt: users.createdAt }).from(users).orderBy(desc(users.createdAt)).limit(supportersPageSize).offset((supportersPage - 1) * supportersPageSize) : [];
const supportersUrl = (page: number) => `?page=${page}`;
const pageTitle = isSupporters ? 'My supporters' : isNotifications ? 'Notifications' : isMedia ? 'File management' : isEmail ? 'Email settings' : isPayments ? 'Payments and orders' : isShop ? 'Shop' : isOperations ? 'System activity' : isSettings ? 'Settings' : 'Overview';
const navItems = [
  { label: 'Home', href: `/${adminPath}`, icon: 'home' as const },
  { label: 'Your page', href: '/', icon: 'page' as const },
  // { label: 'Feed', href: `/${adminPath}/feed`, icon: 'feed' as const },
  { label: 'Settings', href: `/${adminPath}/settings`, icon: 'settings' as const },
  { label: 'Email', href: `/${adminPath}/email`, icon: 'mail' as const },
  { label: 'Notifications', href: `/${adminPath}/notifications`, icon: 'alerts' as const },
  { label: 'Files', href: `/${adminPath}/media`, icon: 'files' as const },
  { label: 'System activity', href: `/${adminPath}/operations`, icon: 'activity' as const },
];
const supportItems = [
  { label: 'Payments & orders', href: `/${adminPath}/payments`, icon: 'payments' as const },
  { label: 'My supporters', href: `/${adminPath}/supporters`, icon: 'supporters' as const },
  // { label: 'Messages', href: `/${adminPath}/messages`, icon: 'messages' as const },
];
const earnItems = [
  // { label: 'Memberships', href: `/${adminPath}/memberships`, icon: 'memberships' as const },
  { label: 'Shop', href: `/${adminPath}/shop`, icon: 'shop' as const },
  // { label: 'Commissions', href: `/${adminPath}/commissions`, icon: 'commissions' as const },
  // { label: 'Buttons & widgets', href: `/${adminPath}/widgets`, icon: 'widgets' as const },
  // { label: 'Discord', href: `/${adminPath}/discord`, icon: 'discord' as const },
  // { label: 'Stream alerts', href: `/${adminPath}/alerts`, icon: 'alerts' as const },
  // { label: 'Promote your page', href: `/${adminPath}/promote`, icon: 'promote' as const },
  // { label: 'More', href: `/${adminPath}/more`, icon: 'more' as const },
];

function isActive(label: string) {
  return (label === 'Settings' && isSettings) || (label === 'Email' && isEmail) || (label === 'Notifications' && isNotifications) || (label === 'Files' && isMedia) || (label === 'Shop' && isShop) || (label === 'System activity' && isOperations) || (label === 'Payments & orders' && isPayments) || (label === 'My supporters' && isSupporters) || (label === 'Home' && currentPath === adminPath);
}
---
<html lang="en" class="admin-page">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" type="image/png" href="/icon.png" /><link rel="preload" href={geistLatinFont} as="font" type="font/woff2" crossorigin /><style is:inline>html { font-family: 'Geist Variable', Arial, sans-serif; } .admin-body { font-size: 16px; }</style><title>{pageTitle} — FreeCoffee.bio</title><script is:inline>try { if (localStorage.getItem('freecoffee-theme') === 'dark') document.documentElement.classList.add('dark'); } catch {}</script></head>
  <body class="admin-body">
    <ToastHost client:load />
    <div class="admin-shell">
      <aside class="admin-sidebar" id="admin-sidebar">
        <a class="admin-brand" href={`/${adminPath}`} aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" /></a>
        <nav class="admin-nav" aria-label="Main navigation">
          {navItems.map((item) => <a class:list={['admin-nav-item', { 'is-active': isActive(item.label) }]} href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
          {supportItems.length > 0 && <p class="admin-nav-label">My support</p>}
          {supportItems.map((item) => <a class="admin-nav-item" href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
          {earnItems.length > 0 && <p class="admin-nav-label">More ways to earn</p>}
          {earnItems.map((item) => <a class:list={['admin-nav-item', { 'is-active': isActive(item.label) }]} href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
        </nav>
        <ShareDialog client:load url={publicSiteUrl} displayName={workspace.creator.displayName} />
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <Button className="admin-menu-button" type="button" data-menu-toggle aria-label="Open navigation"><AdminIcon name="menu" size={21} /></Button>
          <div class="admin-top-actions">
            <a class="page-pill" href="/" target="_blank" rel="noreferrer"><span class="mini-avatar"><AdminIcon name="page" size={14} /></span> Your page</a>
            <Button className="top-icon" variant="ghost" type="button" aria-label="Notifications"><AdminIcon name="alerts" size={19} /></Button>
            <Button className="top-icon theme-icon" variant="ghost" type="button" data-theme-toggle aria-label="Switch to dark mode"><span data-theme-light><AdminIcon name="sun" size={19} /></span><span data-theme-dark><AdminIcon name="moon" size={19} /></span></Button>
            <Button className="top-icon" variant="ghost" type="button" data-logout aria-label="Sign out"><AdminIcon name="logout" size={19} /></Button>
          </div>
        </header>

        <main class="admin-content">
          {isNotifications ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Messaging</p><h1>Notifications</h1><p>Manage reusable message templates and review delivery activity across channels.</p></div>
              <NotificationsManager client:load initialTemplates={notificationTemplates} initialDeliveries={notificationDeliveriesLog} />
            </>
          ) : isMedia ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Creator tools</p><h1>File management</h1><p>Store images and files in your S3-compatible object storage.</p></div>
              <MediaManager client:load initialStorage={mediaStorage} initialFiles={mediaContent} />
            </>
          ) : isEmail ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Delivery</p><h1>Email settings</h1><p>Choose and configure the service used for receipts and creator notifications.</p></div>
              <EmailManager client:load initialSettings={workspace.email} initialDelivery={workspace.emailDelivery} />
            </>
          ) : isOperations ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Reliability</p><h1>System activity</h1><p>Inspect payment provider webhooks and scheduled task activity.</p></div>
              <SystemActivityManager client:load paymentEvents={paymentEventLog} />
            </>
          ) : isSupporters ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Community</p><h1>My supporters</h1><p>Review the registered users who can support your page and manage their purchases.</p></div>
              <section class="rounded-lg border bg-card">
                <div class="flex items-center justify-between gap-4 border-b px-5 py-4"><h2 class="text-base font-semibold">Users</h2><span class="text-sm text-muted-foreground">{supporterCount} total</span></div>
                {supporterUsers.length ? <><Table><TableHeader><TableRow><TableHead>Name</TableHead><TableHead>Email</TableHead><TableHead>Status</TableHead><TableHead className="text-right">Joined</TableHead></TableRow></TableHeader><TableBody>{supporterUsers.map((supporter) => <TableRow key={supporter.id}><TableCell className="font-medium">{supporter.name}</TableCell><TableCell>{supporter.email}</TableCell><TableCell><Badge variant={supporter.emailVerified ? 'secondary' : 'outline'}>{supporter.emailVerified ? 'Verified' : 'Unverified'}</Badge></TableCell><TableCell className="text-right text-muted-foreground">{supporter.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</TableCell></TableRow>)}</TableBody></Table>{supporterCount > supportersPageSize && <Pagination className="px-5 py-4"><PaginationContent><PaginationItem><PaginationPrevious href={supportersUrl(Math.max(1, supportersPage - 1))} aria-disabled={supportersPage === 1} /></PaginationItem>{Array.from({ length: supporterPageCount }, (_, index) => index + 1).map((page) => <PaginationItem key={page}><PaginationLink href={supportersUrl(page)} isActive={page === supportersPage}>{page}</PaginationLink></PaginationItem>)}<PaginationItem><PaginationNext href={supportersUrl(Math.min(supporterPageCount, supportersPage + 1))} aria-disabled={supportersPage === supporterPageCount} /></PaginationItem></PaginationContent></Pagination>}</> : <Empty className="min-h-52 border-0"><EmptyMedia><AdminIcon name="supporters" size={20} /></EmptyMedia><EmptyHeader><EmptyTitle>No supporters yet</EmptyTitle><EmptyDescription>Registered users will appear here as your community grows.</EmptyDescription></EmptyHeader></Empty>}
              </section>
            </>
          ) : isPayments ? (
            <>
              <div class="admin-heading"><h1>Payments and orders</h1><p>Review tips and shop orders in one place.</p></div>
              <PaymentsManager client:load supports={supports} orders={creatorOrders} />
            </>
          ) : isShop ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Creator tools</p><h1>Shop</h1><p>Sell digital items in your own shop.</p></div>
              <AdminTabs client:load group="shop" activeTab={settingsTab === 'orders' ? 'orders' : 'setup'} tabs={[{ value: 'setup', label: 'Setup' }, { value: 'orders', label: 'Orders' }]} />
              <div class="settings-panels" data-settings-panels="shop">
              <div data-admin-panel="setup" hidden={settingsTab === 'orders'}>
              <a class="shop-video" href="#products"><span class="video-thumb"><AdminIcon name="shop" size={17} /></span><strong>Video: Setting up your shop</strong><ArrowRight className="shop-link-arrow" size={16} aria-hidden="true" /></a>
              <section class="shop-card shop-status-card"><h2>Status</h2><p>Show or hide your shop tab on your page.</p><ShopStatusSelect client:load showShop={workspace.page?.showShop ?? true} /></section>
              <section class="shop-card" id="products"><ShopProductsManager client:load products={shopProducts} currency={siteSettings.currency} /></section>
              <section class="shop-card"><h2>Contact details</h2><p>Buyers can use this email for questions about an order.</p><Input className="shop-input" type="email" defaultValue={sessionUser.email} readOnly aria-label="Contact email" /></section>
              <section class="shop-card"><h2>Shop terms</h2><p>These terms apply to every product. Include your refund policy, delivery details, and licence conditions.</p><ShopTermsEditor client:load displayName={workspace.creator.displayName} initialTerms={workspace.page?.terms ?? ''} /></section>
              <a class="shop-settings-link" href={`/${adminPath}/settings?tab=payment`}><span><strong>Sales tax</strong><small>Manage the global rate used for new shop orders.</small></span><ArrowRight className="shop-link-arrow" size={18} aria-hidden="true" /></a>
              </div>
              <section class="payments-card" data-admin-panel="orders" hidden={settingsTab !== 'orders'}><div class="flex flex-col gap-5 border-b pb-5"><div><h2 class="text-base font-semibold">Orders</h2><p class="text-sm text-muted-foreground">Filter and inspect order delivery details.</p></div><form class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center" method="get"><input type="hidden" name="tab" value="orders" /><select name="status" aria-label="Filter by order status" class="h-9 rounded-lg border bg-background px-3 text-sm"><option value="" selected={!orderStatusFilter}>All statuses</option><option value="pending" selected={orderStatusFilter === 'pending'}>Pending</option><option value="paid" selected={orderStatusFilter === 'paid'}>Paid</option><option value="failed" selected={orderStatusFilter === 'failed'}>Failed</option></select><Input className="h-9 w-full sm:w-52" name="email" type="email" defaultValue={orderEmailFilter ?? ''} placeholder="Buyer email" aria-label="Filter by buyer email" /><Input className="h-9 w-full sm:w-40" name="from" type="date" defaultValue={orderFromFilter ?? ''} aria-label="Orders from date" /><Input className="h-9 w-full sm:w-40" name="to" type="date" defaultValue={orderToFilter ?? ''} aria-label="Orders to date" /><Button type="submit">Filter</Button></form></div>{creatorOrders.length ? <><ShopOrdersManager client:load orders={creatorOrders} />{orderTotal > 0 && <Pagination className="mt-5"><PaginationContent><PaginationItem><PaginationPrevious href={orderUrl(Math.max(1, orderPage - 1))} aria-disabled={orderPage === 1} /></PaginationItem>{Array.from({ length: orderPageCount }, (_, index) => index + 1).map((page) => <PaginationItem key={page}><PaginationLink href={orderUrl(page)} isActive={page === orderPage}>{page}</PaginationLink></PaginationItem>)}<PaginationItem><PaginationNext href={orderUrl(Math.min(orderPageCount, orderPage + 1))} aria-disabled={orderPage === orderPageCount} /></PaginationItem></PaginationContent></Pagination>}</> : <Empty className="min-h-52 border-0"><EmptyMedia><AdminIcon name="shop" size={20} /></EmptyMedia><EmptyHeader><EmptyTitle>No orders yet</EmptyTitle><EmptyDescription>Orders will appear here after a customer makes a purchase.</EmptyDescription></EmptyHeader></Empty>}</section>
              </div>
            </>
          ) : isSettings ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Workspace</p><h1>Settings</h1><p>Shape how your page looks and how supporters can reach you.</p></div>
              <AdminTabs client:load group="settings" activeTab={settingsTab} tabs={[{ value: 'profile', label: 'Public profile' }, { value: 'payment', label: 'Payment' }, { value: 'page', label: 'Page' }, { value: 'security', label: 'Security' }]} />
              <div class="settings-panels" data-settings-panels="settings">
                <section class="settings-card" data-admin-panel="profile" hidden={settingsTab !== 'profile'}>
                  <div class="profile-photo"><ProfileAvatar image={workspace.creator.image} name={workspace.creator.displayName} /><input class="sr-only" id="creator-avatar" type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-avatar-input /><Button type="button" variant="ghost" data-avatar-trigger>Change photo</Button><p class="field-help">PNG, JPEG, WebP, or GIF up to 5 MB.</p></div>
                  <form class="profile-form" data-profile-form data-current-currency={siteSettings.currency}>
                    <label><span class="field-label">Display name <span class="hint"><AdminIcon name="info" size={14} /></span></span><Input defaultValue={workspace.creator.displayName} name="displayName" /></label>
                    
                    <label><span class="field-label">About you <span class="hint"><AdminIcon name="info" size={14} /></span></span><Textarea name="bio" rows={5} defaultValue={workspace.creator.bio ?? ''} placeholder="Tell supporters what you make and why it matters." /></label>
                    <label><span class="field-label">What do you do? <span class="hint"><AdminIcon name="info" size={14} /></span></span><div class="tag-input"><span>Creator <Button type="button" variant="ghost" size="icon" aria-label="Remove tag"><AdminIcon name="close" size={13} /></Button></span></div></label>
                    <label><span class="field-label">Site URL <span class="hint"><AdminIcon name="info" size={14} /></span></span><div class="input-with-button"><Input defaultValue={siteSettings.siteUrl} name="siteUrl" type="url" placeholder="https://your-domain.com" /><Button type="submit">Save</Button></div><span class="field-help">Use the site origin only. Do not include <code>/{adminPath}</code> or a callback path.</span></label><label><span class="field-label">Website <span class="hint"><AdminIcon name="info" size={14} /></span></span><Input name="website" type="url" defaultValue={workspace.creator.website ?? ''} placeholder="https://" /></label>
                    <SocialLinksDialog client:load displayName={workspace.creator.displayName} bio={workspace.creator.bio} website={workspace.creator.website} initialLinks={workspace.creator.socialLinks} />
                    <hr />
                    <div class="connected-heading"><h2>Connected accounts</h2><p>Link platforms you use for streaming and content.</p></div>
                    {[{ label: 'x.com', Icon: SiX }, { label: 'Twitch', Icon: SiTwitch }, { label: 'YouTube', Icon: SiYoutube }].map((account) => <div class="connected-row"><span class="connected-account"><account.Icon className="size-4" aria-hidden="true" /> {account.label}</span><Button type="button" variant="outline">Connect</Button></div>)}
                    <Button className="save-button" type="submit">Save changes</Button><p class="form-status" data-form-status role="status"></p>
                  </form>
                </section>
                <section class="settings-card" data-admin-panel="payment" hidden={settingsTab !== 'payment'}>
                  <div class="connected-heading"><h2>Payment provider settings</h2><p>Connect a provider to accept shop payments and support contributions. Credentials are stored securely and never displayed after saving.</p></div><div class="profile-form"><div class="connected-heading"><h2>Commerce settings</h2><p>Currency, tax and exchange rates apply to new prices and payments. Historical transactions keep their original currency and amount.</p></div><CommerceSettingsForm client:load currency={siteSettings.currency} taxRate={(siteSettings.taxRate / 100).toFixed(2)} exchangeRates={{ CNY: configuredRates.find((item) => item.quoteCurrency === 'CNY')?.rate ?? '', EUR: configuredRates.find((item) => item.quoteCurrency === 'EUR')?.rate ?? '', GBP: configuredRates.find((item) => item.quoteCurrency === 'GBP')?.rate ?? '', JPY: configuredRates.find((item) => item.quoteCurrency === 'JPY')?.rate ?? '' }} /></div><hr class="payment-section-divider" /><section class="payment-accounts"><div class="connected-heading"><h2>Payment accounts</h2><p>Manage the services that accept support and shop payments.</p></div><div class="payment-account-list">{(['stripe', 'paypal'] as const).map((provider) => { const account = workspace.paymentAccounts.find((item) => item.provider === provider); const connected = providerConfigured[provider] && account?.status === 'connected'; const Icon = provider === 'stripe' ? SiStripe : SiPaypal; const name = provider === 'stripe' ? 'Stripe' : 'PayPal'; return <div class="payment-account-row"><div class="payment-account-details"><span class="payment-provider-icon"><Icon className={provider === 'stripe' ? 'size-6 text-[#635BFF]' : 'size-6 text-[#003087]'} aria-hidden="true" /></span><div><div class="flex items-center gap-2"><strong>{name}</strong><Badge variant={connected ? 'secondary' : 'outline'}>{connected ? 'Connected' : 'Not connected'}</Badge></div><p>{provider === 'stripe' ? 'Credit and debit card payments.' : 'PayPal account payments.'}</p></div></div><PaymentAccountDialog client:load provider={provider} connected={connected} paypalSandbox={paymentSettings.paypalSandbox} /></div>; })}</div></section><section class="wallet-section"><div class="connected-heading"><h2>Crypto wallets</h2><p>Wallet configuration is reserved for the final payment phase.</p></div>{workspace.wallets.length ? <div class="payment-account-list">{workspace.wallets.map((wallet) => <div class="payment-account-row"><strong>{wallet.network} · {wallet.asset}</strong><Badge variant={wallet.enabled ? 'secondary' : 'outline'}>{wallet.enabled ? 'Enabled' : 'Disabled'}</Badge></div>)}</div> : <p class="wallet-state">No wallets configured yet.</p>}</section></section>
                <section class="settings-card" data-admin-panel="page" hidden={settingsTab !== 'page'}>
                  <div class="connected-heading"><h2>Page settings</h2><p>Control the public page message, support options, and shop visibility.</p></div><div class="profile-form"><PageSettingsForm client:load displayName={workspace.creator.displayName} currency={siteSettings.currency} page={workspace.page} /></div>
                </section>
                <section class="settings-card" data-admin-panel="security" hidden={settingsTab !== 'security'}>
                  <SecuritySettings client:load initial={securityStatus} />
                </section>
              </div>
            </>
          ) : (
            <>
              <div class="admin-heading"><p class="admin-kicker">Admin / overview</p><h1>Good to see you, {sessionUser.name.split(' ')[0]}.</h1><p>Your creator workspace, at a glance.</p></div>
              <section class="welcome-card"><div><p class="card-eyebrow">Your page is ready for its first visitor</p><h2>Make it yours.</h2><p>Complete your profile so supporters know who they’re backing.</p><a class="primary-button" href={`/${adminPath}/settings`}>Set up your page <ArrowRight size={16} aria-hidden="true" /></a></div><div class="welcome-orbit">☕</div></section>
              <div class="overview-grid"><article class="metric-card"><span>Support received</span><strong>{siteSettings.currency} totals shown separately</strong><small>Across support and shop</small></article><article class="metric-card"><span>Transactions</span><strong>{totalTransactions}</strong><small>Support and orders</small></article><article class="metric-card"><span>Page visits</span><strong>—</strong><small>Coming soon</small></article></div>
              <section class="activity-card"><div class="section-title"><div><p class="admin-kicker">Latest</p><h2>Activity</h2></div><a href={`/${adminPath}/payments`}>View all <ArrowRight size={15} aria-hidden="true" /></a></div><div class="empty-state"><span>☕</span><h3>Your activity will appear here</h3><p>When someone supports your work, you’ll see it in this space.</p></div></section>
            </>
          )}
        </main>
      </div>
    </div>
    <script is:inline>
      const showToast = (message, type = 'error') => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type } }));
      window.addEventListener('freecoffee:admin-tab-change', (event) => { const { group, value } = event.detail; const container = document.querySelector(`[data-settings-panels="${group}"]`); container?.querySelectorAll('[data-admin-panel]').forEach((panel) => { panel.hidden = panel.dataset.adminPanel !== value; }); });
      const sidebar = document.querySelector('#admin-sidebar');
      document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => sidebar?.classList.toggle('is-open'));
      sidebar?.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', () => sidebar.classList.remove('is-open')));
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const updateThemeButton = () => { const dark = document.documentElement.classList.contains('dark'); themeToggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); };
      updateThemeButton();
      themeToggle?.addEventListener('click', () => { const dark = !document.documentElement.classList.contains('dark'); document.documentElement.classList.toggle('dark', dark); try { localStorage.setItem('freecoffee-theme', dark ? 'dark' : 'light'); } catch {} updateThemeButton(); });
      document.querySelector('[data-logout]')?.addEventListener('click', async () => { window.location.href = '/api/auth/logout'; }); const productDialog = document.querySelector('[data-product-dialog]'); document.querySelector('[data-open-product-dialog]')?.addEventListener('click', () => { if (productDialog instanceof HTMLDialogElement) productDialog.showModal(); }); document.querySelector('[data-close-product-dialog]')?.addEventListener('click', () => { if (productDialog instanceof HTMLDialogElement) productDialog.close(); }); productDialog?.addEventListener('click', (event) => { if (event.target === productDialog && productDialog instanceof HTMLDialogElement) productDialog.close(); });
      const avatarInput = document.querySelector('[data-avatar-input]'); document.querySelector('[data-avatar-trigger]')?.addEventListener('click', () => { if (avatarInput instanceof HTMLInputElement) avatarInput.click(); }); avatarInput?.addEventListener('change', async () => { if (!(avatarInput instanceof HTMLInputElement) || !avatarInput.files?.[0]) return; const form = new FormData(); form.set('file', avatarInput.files[0]); const response = await fetch('/api/admin/avatar', { method: 'POST', body: form }); const result = await response.json().catch(() => ({})); if (!response.ok || !result.image) { showToast(result.error || 'Unable to upload avatar.'); avatarInput.value = ''; return; } const preview = document.querySelector('[data-avatar-preview]'); if (preview) { const image = preview.querySelector('[data-slot="avatar-image"]'); if (image instanceof HTMLImageElement) { image.src = result.image; image.onload = () => showToast('Profile photo updated.', 'success'); image.onerror = () => showToast('Photo uploaded, but it could not be loaded from storage.', 'error'); } } avatarInput.value = ''; if (!preview) showToast('Profile photo updated. Reload the page to view it.', 'success'); });
      document.querySelector('[data-profile-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const profileResponse = await fetch('/api/admin/creator', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ displayName: data.get('displayName'), bio: data.get('bio'), website: data.get('website'), siteUrl: data.get('siteUrl') }) }); if (profileResponse.ok) window.location.reload(); else { const result = await profileResponse.json().catch(() => ({})); showToast(result.error || 'Unable to save profile.'); } }); document.querySelector('[data-email-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ host: data.get('host'), port: data.get('port'), username: data.get('username'), password: data.get('password'), fromAddress: data.get('fromAddress'), replyTo: data.get('replyTo'), secure: data.get('secure') === 'on', enabled: data.get('enabled') === 'on' }) }); if (response.ok) window.location.reload(); else { const result = await response.json().catch(() => ({})); showToast(result.error || 'Unable to save email settings.'); } }); document.querySelector('[data-email-test-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const to = new FormData(form).get('to'); const response = await fetch('/api/admin/email-test', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ to }) }); if (response.ok) showToast('Test email sent.', 'success'); else showToast((await response.json().catch(() => ({}))).error || 'Unable to send test email.'); }); document.querySelector('[data-product-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/products', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name: data.get('name'), description: data.get('description'), price: String(data.get('price')), status: 'draft' }) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to create product.'); }); document.querySelectorAll('[data-product-status]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/products', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: button.dataset.productStatus, status: button.dataset.nextStatus }) }); if (response.ok) window.location.reload(); else showToast('Unable to update product status.'); })); document.querySelectorAll('[data-order-detail]').forEach((button) => button.addEventListener('click', async () => { const panel = document.querySelector('[data-order-detail-panel]'); if (!panel || !button.dataset.orderDetail) return; panel.textContent = 'Loading order details...'; panel.classList.remove('hidden'); const response = await fetch(`/api/admin/transactions?orderId=${encodeURIComponent(button.dataset.orderDetail)}`); const data = await response.json().catch(() => ({})); if (!response.ok) { panel.textContent = data.error || 'Unable to load order details.'; return; } panel.replaceChildren(); const heading = document.createElement('strong'); heading.textContent = `Order ${data.order.id}`; panel.append(heading); const summary = document.createElement('p'); summary.className = 'mt-2'; summary.textContent = `${data.order.buyerEmail} · ${data.order.status} · ${data.order.currency}`; panel.append(summary); const totals = document.createElement('p'); totals.className = 'mt-1'; totals.textContent = `Subtotal: ${data.order.subtotalAmount} · Tax: ${data.order.taxAmount} · Total: ${data.order.totalAmount}`; panel.append(totals); const items = document.createElement('p'); items.className = 'mt-1'; items.textContent = `Items: ${data.items.map((item) => `${item.productName} × ${item.quantity}`).join(', ') || 'None'}`; panel.append(items); })); document.querySelector('[data-page-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/creator', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ displayName: data.get('displayName'), themeColor: data.get('themeColor'), welcomeMessage: data.get('welcomeMessage'), defaultSupportAmount: String(data.get('defaultSupportAmount')), allowAnonymous: data.get('allowAnonymous') === 'on', showSupport: data.get('showSupport') === 'on', showShop: data.get('showShop') === 'on', supportGoalEnabled: data.get('supportGoalEnabled') === 'on', supportGoalTitle: data.get('supportGoalTitle'), supportGoalAmount: String(data.get('supportGoalAmount')), supportGoalDescription: data.get('supportGoalDescription'), terms: data.get('terms') }) }); if (response.ok) window.location.reload(); else { const result = await response.json().catch(() => ({})); showToast(result.error || 'Unable to save page settings.'); } }); document.querySelector('[data-payment-settings-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const commerceResponse = await fetch('/api/admin/settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ currency: data.get('currency'), taxRate: String(data.get('taxRate') || '0'), exchangeRates: { CNY: data.get('rateCNY'), EUR: data.get('rateEUR'), GBP: data.get('rateGBP'), JPY: data.get('rateJPY') }, confirmCurrencyChange: data.get('currency') === form.dataset.currentCurrency || window.confirm('Changing currency will convert editable prices and support settings. Historical transactions will not change. Continue?') }) }); if (commerceResponse.ok) window.location.reload(); else { const result = await commerceResponse.json().catch(() => ({})); showToast(result.error || 'Unable to save commerce settings.'); } }); document.querySelectorAll('[data-payment-provider]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/payment-accounts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ provider: button.dataset.paymentProvider, status: button.dataset.paymentStatus }) }); if (response.ok) window.location.reload(); }));
      const contentForm = (selector, type, fields) => document.querySelector(selector)?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(event.currentTarget); const body = { type }; fields.forEach((field) => { body[field] = data.get(field); }); const response = await fetch('/api/admin/content', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to create content.'); });
      contentForm('[data-gallery-form]', 'gallery', ['title', 'description', 'imageUrl', 'linkUrl']);

      document.querySelectorAll('[data-content-id]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/content', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: button.dataset.contentType, id: button.dataset.contentId, status: button.dataset.contentStatus }) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to update content.'); }));
    </script>
  </body>
</html>
