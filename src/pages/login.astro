---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Turnstile } from '../components/turnstile';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Sign in — FreeCoffee.bio</title></head>
  <body class="min-h-screen bg-muted/30">
    <ToastHost client:load />
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4">
      <section class="w-full rounded-xl border bg-card p-6 shadow-sm">
        <a href="/" class="inline-flex" aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" class="h-10 w-auto" /></a>
        <h1 class="mt-6 text-3xl font-semibold">Welcome back</h1>
        <p class="mt-3 text-sm text-muted-foreground">Sign in to support creators and manage your purchases.</p>
        <form class="mt-7 space-y-4" id="user-login-form">
          <label class="block text-sm font-medium">Email<Input required name="email" type="email" autoComplete="email" className="mt-2 h-11 w-full" /></label>
          <label class="block text-sm font-medium">Password<Input required name="password" type="password" autoComplete="current-password" className="mt-2 h-11 w-full" /></label>
          <Turnstile client:load />
          <Button className="h-11 w-full" type="submit">Sign in</Button>

        </form>
        <p class="mt-6 text-center text-sm text-muted-foreground">New here? <a class="text-primary underline" href="/register">Create an account</a></p>
      </section>
    </main>
    <script is:inline>
      const form = document.querySelector('#user-login-form');
      const showToast = (message) => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type: 'error' } }));
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const response = await fetch('/api/auth/sign-in/email', { method: 'POST', headers: { 'content-type': 'application/json', 'x-captcha-response': form.querySelector('[data-turnstile-token]')?.value || '' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        const result = await response.json().catch(() => ({}));
        const redirect = new URLSearchParams(window.location.search).get('redirect') || '/';
        if (response.ok && result.twoFactorRedirect) window.location.href = `/two-factor?redirect=${encodeURIComponent(redirect)}`;
        else if (response.ok) window.location.href = redirect;
        else showToast(result.message || 'Unable to sign in. Check your credentials and try again.');
      });
    </script>
  </body>
</html>
