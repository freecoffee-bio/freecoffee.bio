---
import PublicPage from '../../layouts/public-page.astro';
import { SiPaypal, SiStripe } from '@icons-pack/react-simple-icons';
import { ShoppingBag } from 'lucide-react';
import { getDefaultPublicCreator } from '../../server/creator';
import { getCurrentUser } from '../../server/session';
import { getSiteSettings } from '../../server/site-settings';
import { calculateTax, formatMoney, isCurrency } from '../../server/money';

const productId = Astro.params.productId;
if (!productId) return new Response('Not Found', { status: 404 });
const workspace = await getDefaultPublicCreator();
if (!workspace) return new Response('Not Found', { status: 404 });
const currentUser = await getCurrentUser(Astro.request);
const product = workspace.products.find((item) => item.id === productId);
if (!product || workspace.page?.showShop === false) return new Response('Not Found', { status: 404 });
const commerce = await getSiteSettings();
const productCurrency = isCurrency(product.currency) ? product.currency : 'USD';
const taxAmount = calculateTax(product.price, commerce.taxRate, productCurrency);
const totalAmount = product.price + taxAmount;
const defaultProvider = workspace.paymentProviders.stripe ? 'stripe' : 'paypal';
---
<PublicPage title={product.name} description={product.description || product.name} brandName={workspace.creator.displayName} backHref="/#shop" backLabel="Back to shop">
  <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,.92fr)] lg:items-start">
      <section class="overflow-hidden rounded-xl border bg-card shadow-sm">
        <div class="grid aspect-square place-items-center bg-muted">
          {product.coverImageUrl ? <img src={product.coverImageUrl} alt={`${product.name} cover`} class="size-full object-cover" /> : <div class="text-center text-muted-foreground"><ShoppingBag className="mx-auto size-16 stroke-[1.4]" /><p class="mt-4 text-sm">Digital product</p></div>}
        </div>
        <div class="border-t p-5 sm:p-7"><p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Shop item</p><h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{product.name}</h1>{product.description && <p class="mt-4 whitespace-pre-wrap text-base leading-7 text-muted-foreground">{product.description}</p>}</div>
      </section>
      <aside class="rounded-xl border bg-card p-5 shadow-sm sm:p-7 lg:sticky lg:top-6">
        <h2 class="text-2xl font-semibold tracking-tight">{product.name}</h2>
        <p class="mt-5 text-center text-4xl font-semibold tracking-tight">{formatMoney(product.price, productCurrency)}</p>
        <p class="mt-2 text-center text-sm text-muted-foreground">One-time purchase</p>
        <dl class="mt-5 grid gap-2 border-y py-4 text-sm"><div class="flex justify-between"><dt class="text-muted-foreground">Subtotal</dt><dd>{formatMoney(product.price, productCurrency)}</dd></div>{commerce.taxRate > 0 && <div class="flex justify-between"><dt class="text-muted-foreground">Tax ({(commerce.taxRate / 100).toFixed(2)}%)</dt><dd>{formatMoney(taxAmount, productCurrency)}</dd></div>}<div class="flex justify-between font-semibold"><dt>Total</dt><dd>{formatMoney(totalAmount, productCurrency)}</dd></div></dl>
        {workspace.paymentProviders.stripe || workspace.paymentProviders.paypal ? currentUser ? <form class="mt-7 grid gap-3" data-shop-checkout><input type="hidden" name="productId" value={product.id} /><label class="grid gap-2 text-sm font-medium" for="buyer-email">Receipt email<input id="buyer-email" required type="email" name="email" value={currentUser.email} placeholder="you@example.com" class="h-11 rounded-lg border bg-background px-3 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30" /></label><fieldset class="mt-1 grid gap-2"><legend class="text-sm font-medium">Payment method</legend><div class="grid gap-2">{workspace.paymentProviders.stripe && <label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors hover:bg-muted/50 has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5"><input class="peer sr-only" type="radio" name="provider" value="stripe" checked={defaultProvider === 'stripe'} /><SiStripe className="mt-0.5 size-5 shrink-0 text-[#635BFF]" aria-hidden="true" /><span class="min-w-0 flex-1"><span class="block text-sm font-medium">Credit or debit card</span><span class="mt-0.5 block text-sm leading-snug text-muted-foreground">Pay securely with Stripe.</span></span><span class="relative mt-0.5 size-4 shrink-0 rounded-full border border-input peer-checked:border-primary peer-checked:bg-primary peer-focus-visible:ring-3 peer-focus-visible:ring-ring/50 after:absolute after:inset-1 after:rounded-full after:bg-primary-foreground after:content-[''] peer-not-checked:after:hidden" aria-hidden="true"></span></label>}{workspace.paymentProviders.paypal && <label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors hover:bg-muted/50 has-[:checked]:border-primary/30 has-[:checked]:bg-primary/5"><input class="peer sr-only" type="radio" name="provider" value="paypal" checked={defaultProvider === 'paypal'} /><SiPaypal className="mt-0.5 size-5 shrink-0 text-[#003087]" aria-hidden="true" /><span class="min-w-0 flex-1"><span class="block text-sm font-medium">PayPal</span><span class="mt-0.5 block text-sm leading-snug text-muted-foreground">Pay with your PayPal account.</span></span><span class="relative mt-0.5 size-4 shrink-0 rounded-full border border-input peer-checked:border-primary peer-checked:bg-primary peer-focus-visible:ring-3 peer-focus-visible:ring-ring/50 after:absolute after:inset-1 after:rounded-full after:bg-primary-foreground after:content-[''] peer-not-checked:after:hidden" aria-hidden="true"></span></label>}</div></fieldset><p class="hidden rounded-lg bg-muted p-3 text-xs leading-5 text-muted-foreground" data-settlement-quote></p><button type="submit" class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80" data-checkout-button>Buy now <ShoppingBag className="size-4" /></button><p class="text-center text-xs leading-5 text-muted-foreground">Payment is completed securely by the selected provider.</p></form> : <div class="mt-7 grid gap-3"><p class="rounded-lg bg-muted p-3 text-sm leading-5 text-muted-foreground">Sign in is required to purchase this product. Your receipt and order history will be linked to your account.</p><a class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80" href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}>Sign in to buy</a><a class="text-center text-sm text-primary hover:underline" href={`/register?redirect=${encodeURIComponent(Astro.url.pathname)}`}>Create an account</a></div> : <p class="mt-7 rounded-lg bg-muted p-3 text-sm leading-5 text-muted-foreground">Purchases are temporarily unavailable.</p>}
      </aside>
    </div>
  </article>
  <script is:inline>
    const checkoutForm = document.querySelector('[data-shop-checkout]');
    const quoteBox = document.querySelector('[data-settlement-quote]');
    const checkoutButton = document.querySelector('[data-checkout-button]');
    const loadQuote = async () => {
      if (!checkoutForm || !quoteBox) return;
      const data = new FormData(checkoutForm);
      const response = await fetch(`/api/shop/quote?productId=${encodeURIComponent(data.get('productId'))}&provider=${encodeURIComponent(data.get('provider'))}`);
      const quote = await response.json();
      if (!response.ok) { quoteBox.textContent = quote.error || 'Unable to calculate checkout quote.'; quoteBox.classList.remove('hidden'); return; }
      if (quote.settlementCurrency !== quote.currency) { quoteBox.textContent = `Provider settlement: ${quote.settlement} (${quote.settlementCurrency}). Conversion rate: 1 ${quote.currency} = ${quote.exchangeRate} ${quote.settlementCurrency}.`; quoteBox.classList.remove('hidden'); } else quoteBox.classList.add('hidden');
    };
    checkoutForm?.querySelector('[name="provider"]')?.addEventListener('change', loadQuote);
    checkoutForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!checkoutButton) return;
      checkoutButton.disabled = true;
      checkoutButton.textContent = 'Opening secure checkout...';
      const response = await fetch('/api/shop/create', { method: 'POST', headers: { accept: 'application/json' }, body: new FormData(checkoutForm) });
      const result = await response.json().catch(() => ({}));
      if (response.ok && result.checkoutUrl) window.location.href = result.checkoutUrl;
      else { window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message: result.error || 'Unable to create checkout.', type: 'error' } })); checkoutButton.disabled = false; checkoutButton.textContent = 'Buy now'; }
    });
    loadQuote();
  </script>
</PublicPage>
