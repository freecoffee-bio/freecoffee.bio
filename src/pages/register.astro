---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Turnstile } from '../components/turnstile';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Create account — FreeCoffee.bio</title></head>
  <body class="min-h-screen bg-muted/30">
    <ToastHost client:load />
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4">
      <section class="w-full rounded-xl border bg-card p-6 shadow-sm">
        <a href="/" class="inline-flex" aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" class="h-10 w-auto" /></a>
        <h1 class="mt-6 text-3xl font-semibold">Create your account</h1>
        <p class="mt-3 text-sm text-muted-foreground">Join FreeCoffee to support creators and keep track of your purchases.</p>
        <form class="mt-7 space-y-4" id="user-register-form">
          <label class="block text-sm font-medium">Name<Input required name="name" maxLength={100} autoComplete="name" className="mt-2 h-11 w-full" /></label>
          <label class="block text-sm font-medium">Email<Input required name="email" type="email" autoComplete="email" className="mt-2 h-11 w-full" /></label>
          <label class="block text-sm font-medium">Password<Input required name="password" type="password" minLength={8} maxLength={128} autoComplete="new-password" className="mt-2 h-11 w-full" /><span class="mt-1 block text-xs text-muted-foreground">At least 8 characters.</span></label>
          <Turnstile client:load />
          <Button className="h-11 w-full" type="submit">Create account</Button>

        </form>
        <p class="mt-6 text-center text-sm text-muted-foreground">Already have an account? <a class="text-primary underline" href="/login">Sign in</a></p>
      </section>
    </main>
    <script is:inline>
      const form = document.querySelector('#user-register-form');
      const showToast = (message) => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type: 'error' } }));
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = Object.fromEntries(new FormData(form));
        const response = await fetch('/api/auth/sign-up/email', { method: 'POST', headers: { 'content-type': 'application/json', 'x-captcha-response': form.querySelector('[data-turnstile-token]')?.value || '' }, body: JSON.stringify(data) });
        if (response.ok) window.location.href = `/verify-email?email=${encodeURIComponent(String(data.email || ''))}`;
        else { const result = await response.json().catch(() => ({})); showToast(result.message || 'Unable to create account. Please check your details.'); }
      });
    </script>
  </body>
</html>
