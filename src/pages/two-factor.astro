---
import '../styles/global.css';
import { ToastHost } from '../components/toast-host';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" type="image/png" href="/icon.png" /><title>Verify sign in — FreeCoffee.bio</title></head><body class="min-h-screen bg-muted/30"><ToastHost client:load /><main class="mx-auto flex min-h-screen max-w-md items-center px-4"><section class="w-full rounded-xl border bg-card p-6 shadow-sm"><a href="/" class="inline-flex" aria-label="FreeCoffee home"><img src="/logo.png" alt="FreeCoffee.bio" class="h-10 w-auto" /></a><h1 class="mt-6 text-3xl font-semibold">Verify your sign in</h1><p class="mt-3 text-sm text-muted-foreground">Enter the six-digit code from your authenticator app.</p><form class="mt-7 space-y-4" id="two-factor-form"><label class="block text-sm font-medium">Verification code<Input required name="code" inputMode="numeric" pattern="[0-9]{6}" maxLength={8} autoComplete="one-time-code" className="mt-2 h-11 w-full" /></label><Button className="h-11 w-full" type="submit">Verify and sign in</Button></form></section></main><script is:inline>const form = document.querySelector('#two-factor-form'); const showToast = (message) => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type: 'error' } })); form?.addEventListener('submit', async (event) => { event.preventDefault(); const response = await fetch('/api/auth/two-factor/verify-totp', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) }); if (response.ok) window.location.href = new URLSearchParams(window.location.search).get('redirect') || '/'; else { const result = await response.json().catch(() => ({})); showToast(result.message || 'Invalid verification code.'); } });</script></body></html>
