---
import PublicPage from '../layouts/public-page.astro';
import { TwoFactorSettings } from '../components/two-factor-settings';
import { getCurrentUser } from '../server/session';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect(`/login?redirect=${encodeURIComponent('/account')}`);
---
<PublicPage title="Account security" description={`Manage sign-in protection for ${user.email}.`}>
  <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
    <section class="rounded-xl border bg-card p-5 shadow-sm sm:p-7">
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Account</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Account security</h1>
      <p class="mt-4 text-base leading-7 text-muted-foreground">Manage sign-in protection for {user.email}.</p>
      <div class="mt-8">
        <TwoFactorSettings client:load initialEnabled={user.twoFactorEnabled ?? false} />
      </div>
    </section>
  </article>
</PublicPage>
