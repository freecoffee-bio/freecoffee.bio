---
import '../../styles/global.css';
import geistLatinFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2';
import { ArrowLeft, Coffee, ShoppingBag } from 'lucide-react';
import { getDefaultPublicCreator } from '../../server/creator';
import { getCurrentUser } from '../../server/session';
import { ToastHost } from '../../components/toast-host';
import { getSiteSettings } from '../../server/site-settings';
import { calculateTax, formatMoney, isCurrency } from '../../server/money';

const productId = Astro.params.productId;
if (!productId) return new Response('Not Found', { status: 404 });
const workspace = await getDefaultPublicCreator();
if (!workspace) return new Response('Not Found', { status: 404 });
const currentUser = await getCurrentUser(Astro.request);
const product = workspace.products.find((item) => item.id === productId);
if (!product || workspace.page?.showShop === false) return new Response('Not Found', { status: 404 });
const title = product.name;
const creatorUrl = '/';
const backLabel = 'Back to shop';
const commerce = await getSiteSettings();
const productCurrency = isCurrency(product.currency) ? product.currency : 'USD';
const taxAmount = calculateTax(product.price, commerce.taxRate, productCurrency);
const totalAmount = product.price + taxAmount;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href={geistLatinFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={product.description || title} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <title>{title} — {workspace.creator.displayName}</title>
  </head>
  <body>
    <script is:inline>try { if (localStorage.getItem('freecoffee-theme') === 'dark') document.documentElement.classList.add('dark'); } catch {}</script>
    <ToastHost client:load />
    <main class="min-h-screen bg-muted/30 text-foreground">
      <header class="border-b bg-background">
        <div class="mx-auto flex min-h-16 max-w-5xl items-center justify-between gap-4 px-4">
          <a href={creatorUrl} class="flex items-center gap-2 font-semibold tracking-tight">
            <span class="grid size-8 place-items-center rounded-lg bg-primary text-primary-foreground"><Coffee className="size-4" /></span>
            {workspace.creator.displayName}
          </a>
          <a href={creatorUrl} class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft className="size-4" /> {backLabel}</a>
        </div>
      </header>

      <div class="min-h-[90vh]">

      {product && <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,.92fr)] lg:items-start">
          <section class="overflow-hidden rounded-xl border bg-card shadow-sm">
            <div class="grid aspect-square place-items-center bg-muted">
              {product.coverImageUrl ? <img src={product.coverImageUrl} alt={`${product.name} cover`} class="size-full object-cover" /> : <div class="text-center text-muted-foreground"><ShoppingBag className="mx-auto size-16 stroke-[1.4]" /><p class="mt-4 text-sm">Digital product</p></div>}
            </div>
            <div class="border-t p-5 sm:p-7"><p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Shop item</p><h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{product.name}</h1>{product.description && <p class="mt-4 whitespace-pre-wrap text-base leading-7 text-muted-foreground">{product.description}</p>}</div>
          </section>
          <aside class="rounded-xl border bg-card p-5 shadow-sm sm:p-7 lg:sticky lg:top-6">
            <p class="text-sm text-muted-foreground">{workspace.creator.displayName}'s shop</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">{product.name}</h2>
            <p class="mt-5 text-center text-4xl font-semibold tracking-tight">{formatMoney(product.price, productCurrency)}</p>
            <p class="mt-2 text-center text-sm text-muted-foreground">One-time purchase</p>
            <dl class="mt-5 grid gap-2 border-y py-4 text-sm"><div class="flex justify-between"><dt class="text-muted-foreground">Subtotal</dt><dd>{formatMoney(product.price, productCurrency)}</dd></div>{commerce.taxRate > 0 && <div class="flex justify-between"><dt class="text-muted-foreground">Tax ({(commerce.taxRate / 100).toFixed(2)}%)</dt><dd>{formatMoney(taxAmount, productCurrency)}</dd></div>}<div class="flex justify-between font-semibold"><dt>Total</dt><dd>{formatMoney(totalAmount, productCurrency)}</dd></div></dl>
            {workspace.paymentProviders.stripe || workspace.paymentProviders.paypal ? currentUser ? <form class="mt-7 grid gap-3" data-shop-checkout><input type="hidden" name="productId" value={product.id} /><label class="grid gap-2 text-sm font-medium" for="buyer-email">Receipt email<input id="buyer-email" required type="email" name="email" defaultValue={currentUser.email} placeholder="you@example.com" class="h-11 rounded-lg border bg-background px-3 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30" /></label><label class="grid gap-2 text-sm font-medium" for="payment-provider">Payment method<select id="payment-provider" name="provider" class="h-11 rounded-lg border bg-background px-3 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30">{workspace.paymentProviders.stripe && <option value="stripe">Card or bank card</option>}{workspace.paymentProviders.paypal && <option value="paypal">PayPal</option>}</select></label><p class="hidden rounded-lg bg-muted p-3 text-xs leading-5 text-muted-foreground" data-settlement-quote></p><button type="submit" class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80" data-checkout-button>Buy now <ShoppingBag className="size-4" /></button><p class="text-center text-xs leading-5 text-muted-foreground">Payment is completed securely by the selected provider.</p></form> : <div class="mt-7 grid gap-3"><p class="rounded-lg bg-muted p-3 text-sm leading-5 text-muted-foreground">Sign in is required to purchase this product. Your receipt and order history will be linked to your account.</p><a class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80" href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}>Sign in to buy</a><a class="text-center text-sm text-primary hover:underline" href={`/register?redirect=${encodeURIComponent(Astro.url.pathname)}`}>Create an account</a></div> : <p class="mt-7 rounded-lg bg-muted p-3 text-sm leading-5 text-muted-foreground">Purchases are temporarily unavailable.</p>}
          </aside>
        </div>
      </article>}
      </div>
      <script is:inline>
        const checkoutForm = document.querySelector('[data-shop-checkout]');
        const quoteBox = document.querySelector('[data-settlement-quote]');
        const checkoutButton = document.querySelector('[data-checkout-button]');
        const loadQuote = async () => {
          if (!checkoutForm || !quoteBox) return;
          const data = new FormData(checkoutForm);
          const response = await fetch(`/api/shop/quote?productId=${encodeURIComponent(data.get('productId'))}&provider=${encodeURIComponent(data.get('provider'))}`);
          const quote = await response.json();
          if (!response.ok) { quoteBox.textContent = quote.error || 'Unable to calculate checkout quote.'; quoteBox.classList.remove('hidden'); return; }
          if (quote.settlementCurrency !== quote.currency) { quoteBox.textContent = `Provider settlement: ${quote.settlement} (${quote.settlementCurrency}). Conversion rate: 1 ${quote.currency} = ${quote.exchangeRate} ${quote.settlementCurrency}.`; quoteBox.classList.remove('hidden'); } else quoteBox.classList.add('hidden');
        };
        checkoutForm?.querySelector('[name="provider"]')?.addEventListener('change', loadQuote);
        checkoutForm?.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!checkoutButton) return;
          checkoutButton.disabled = true;
          checkoutButton.textContent = 'Opening secure checkout...';
          const response = await fetch('/api/shop/create', { method: 'POST', headers: { accept: 'application/json' }, body: new FormData(checkoutForm) });
          const result = await response.json().catch(() => ({}));
          if (response.ok && result.checkoutUrl) window.location.href = result.checkoutUrl;
          else { window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message: result.error || 'Unable to create checkout.', type: 'error' } })); checkoutButton.disabled = false; checkoutButton.textContent = 'Buy now'; }
        });
        loadQuote();
      </script>

      <footer class="border-t bg-background">
        <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-3 px-4 py-5 font-mono text-[14px] text-muted-foreground">
          <a href={creatorUrl}>{workspace.creator.displayName}</a>
          <span>Creator-owned support, made simple.</span>
          <a href="/privacy" class="hover:text-foreground">Privacy</a>
        </div>
      </footer>
    </main>
  </body>
</html>
